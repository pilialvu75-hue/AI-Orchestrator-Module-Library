{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-orchestrator.local/schemas/library.needs.schema.json",
  "title": "AI Orchestrator Library Needs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "items"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "title", "priority", "desired_candidates", "status", "targets"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 3},
          "title": {"type": "string", "minLength": 1},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "desired_candidates": {"type": "integer", "minimum": 1},
          "status": {"enum": ["needed", "researching", "satisfied", "paused"]},
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
