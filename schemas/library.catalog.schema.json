{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-orchestrator.local/schemas/library.catalog.schema.json",
  "title": "AI Orchestrator Module Library Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "library_id", "catalog_version", "updated_at", "assets"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "library_id": {"type": "string", "minLength": 3},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "manifest", "status", "capabilities"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
          "manifest": {"type": "string", "minLength": 1},
          "status": {"enum": ["tested", "certified", "deprecated", "revoked"]},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
