{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-orchestrator.local/schemas/catalog.lifecycle.schema.json",
  "title": "AI Orchestrator Catalog Lifecycle Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "asset_id", "version", "from", "to", "occurred_at", "reason", "source"],
        "properties": {
          "event_id": {"type": "string", "minLength": 3},
          "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
          "from": {"enum": ["active", "deprecated"]},
          "to": {"enum": ["active", "deprecated", "revoked"]},
          "occurred_at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 3},
          "source": {"enum": ["library", "manual", "security", "cantiere"]},
          "replacement": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_id", "version"],
                "properties": {
                  "asset_id": {"type": "string"},
                  "version": {"type": "string"}
                }
              }
            ]
          }
        }
      }
    }
  }
}
