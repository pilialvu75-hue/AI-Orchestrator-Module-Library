{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-orchestrator.local/schemas/module.manifest.schema.json",
  "title": "AI Orchestrator Reusable Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "status",
    "description",
    "capabilities",
    "platforms",
    "provenance",
    "validation",
    "security",
    "integration",
    "connector",
    "payload"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "kind": {
      "enum": [
        "module",
        "component",
        "integration_bundle",
        "architecture_pattern",
        "project_template",
        "policy_bundle"
      ]
    },
    "status": {
      "enum": ["discovered", "quarantined", "normalized", "tested", "certified", "deprecated", "revoked"]
    },
    "description": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "frameworks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entry_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": ["string", "null"]},
          "source": {"type": ["string", "null"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {"enum": ["built_in", "cantiere", "researcher", "open_source", "imported"]},
        "source_repository": {"type": ["string", "null"]},
        "source_commit": {"type": ["string", "null"]},
        "source_tag": {"type": ["string", "null"]},
        "source_project_id": {"type": ["string", "null"]},
        "source_task_id": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "license_file": {"type": ["string", "null"]},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "tests_passed"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "tests_passed": {"type": "boolean"},
        "test_report": {"type": ["string", "null"]},
        "validated_at": {"type": ["string", "null"], "format": "date-time"},
        "validated_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed"],
      "properties": {
        "reviewed": {"type": "boolean"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "known_vulnerabilities": {"type": "integer", "minimum": 0},
        "sbom": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated_effort", "adaptation_allowed"],
      "properties": {
        "estimated_effort": {"enum": ["trivial", "low", "medium", "high"]},
        "adaptation_allowed": {"type": "boolean"},
        "known_constraints": {"type": "array", "items": {"type": "string"}},
        "adapter_notes": {"type": ["string", "null"]}
      }
    },
    "connector": {
      "$ref": "./lego.connector.schema.json"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["repository_path", "upstream_reference", "archive"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "upstream_repository": {"type": ["string", "null"]},
        "upstream_commit": {"type": ["string", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reuse_count": {"type": "integer", "minimum": 0},
        "successful_integrations": {"type": "integer", "minimum": 0},
        "failed_integrations": {"type": "integer", "minimum": 0},
        "last_used_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {"type": ["string", "null"]},
        "replacement": {"type": ["string", "null"]}
      }
    }
  }
}
