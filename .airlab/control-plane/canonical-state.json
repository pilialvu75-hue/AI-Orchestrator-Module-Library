  "chat_archive_policy": {
    "consolidation_registry": ".airlab/control-plane/historical-chat-consolidation.json",
    "when_chat_is_full": "Open a replacement chat for the same lane using tools/chat_lane_bootstrap.py; do not create a new project state.",
    "deletion_gate": [
      "unique actionable work migrated",
      "unresolved items linked to roadmap/workstream",
      "evidence/decisions with future value preserved",
      "replacement lane/bootstrap available when ongoing work continues"
    ],
    "chat_is_never_authority": true,
    "canonical_state_survives_chat_deletion": true
  },
  "continuous_checkpoint_policy": {
    "mode": "event_driven_incremental",
    "tool": "tools/chat_checkpoint.py",
    "purpose": "Persist meaningful progress continuously so chat context exhaustion is not a continuity event.",
    "checkpoint_on": [
      "material milestone",
      "architectural or product decision",
      "new blocker or changed diagnosis",
      "PR created merged closed or materially changed",
      "CI result that changes next action",
      "Diagnostics/runtime/physical-device result",
      "roadmap priority/scope/dependency change",
      "before long or risky work",
      "before worker review handoff"
    ],
    "autonomous_rule": "Operational chats must checkpoint as part of normal work without waiting for the user to report that the chat is full.",
    "native_context_limit_signal_required": false,
    "rollover_rule": "When a chat fills, replacement chat resumes from the same lane's last_checkpoint and canonical state.",
    "watchdog": {
      "mode": "reviewer_attention",
      "warning_after_minutes": 120,
      "evaluation": "hourly_reconcile_and_event_projection",
      "action": "SURFACE_CHECKPOINT_WATCH",
      "automatic_content_generation": false,
      "automatic_block_before_claim_expiry": false,
      "rationale": "Detect lanes that may be working without recently persisted resume state while avoiding false blocking during legitimate waits."
    }
  },
  "mutation_policy": {
    "mode": "transactional_inbox_compare_and_swap",
    "processor": "tools/control_plane_inbox.py",
    "pending": ".airlab/control-plane/inbox/pending/",
