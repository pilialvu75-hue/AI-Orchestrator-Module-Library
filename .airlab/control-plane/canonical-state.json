{
  "schema_version": 1,
  "authority": {
    "repository": "pilialvu75-hue/AI-Orchestrator-Module-Library",
    "path": ".airlab/control-plane/canonical-state.json",
    "owner_lane": "main-reviewer",
    "policy": "This private repository is the single coordination authority. Chats and agents are workers, not independent sources of truth."
  },
  "updated_at": "2026-10-01",
  "state_revision": 2,
  "lifecycle_status": "BOOTSTRAP_ACTIVE",
  "roadmap_authority": {
    "library": ".airlab/roadmap.yaml",
    "public_repository_registry": ".airlab/public-repositories/",
    "update_rule": "Roadmap and affected workstream state are updated whenever accepted evidence changes priority, scope, dependency or completion state."
  },
  "shared_engine": {
    "primary_repository": "pilialvu75-hue/Ai-orchestrator-riserva",
    "principle": "one_orchestrator_shared_contracts_target_optimized_runtimes",
    "protected_shared_domains": [
      "inference_contract",
      "model_routing_contract",
      "memory",
      "voice_core",
      "diagnostics_contract",
      "cantiere_lifecycle",
      "library_contracts"
    ],
    "platform_rule": "Platform lanes share orchestration/contracts but may and should optimize inference backends, LLMs, quantization and runtime settings for their actual hardware/software target. They must preserve shared inference semantics and evidence gates."
  },
  "promotion_policy": {
    "worker_max_state": "REVIEW_REQUIRED",
    "verified_by": "main-reviewer",
    "done_requires": [
      "required_gates_passed",
      "evidence_recorded",
      "reviewer_approved",
      "roadmap_synced",
      "canonical_state_synced"
    ],
    "ci_green_is_never_sufficient_for_runtime_claims": true,
    "runtime_or_hardware_claims_require_target_runtime_evidence": true
  },
  "workstreams": [
    ".airlab/control-plane/workstreams/main-reviewer.json",
    ".airlab/control-plane/workstreams/cantiere.json",
    ".airlab/control-plane/workstreams/voice-live.json",
    ".airlab/control-plane/workstreams/runtime-core.json",
    ".airlab/control-plane/workstreams/diagnostics.json",
    ".airlab/control-plane/workstreams/platform-android.json",
    ".airlab/control-plane/workstreams/platform-windows.json",
    ".airlab/control-plane/workstreams/platform-windows-legacy.json",
    ".airlab/control-plane/workstreams/platform-linux.json",
    ".airlab/control-plane/workstreams/platform-macos.json",
    ".airlab/control-plane/workstreams/platform-ios.json",
    ".airlab/control-plane/workstreams/platform-web.json",
    ".airlab/control-plane/workstreams/platform-raspberry-pi.json",
    ".airlab/control-plane/workstreams/library-researcher.json",
    ".airlab/control-plane/workstreams/airlab.json"
  ],
  "inference_policy": ".airlab/control-plane/inference-policy.json",
  "claim_policy": {
    "mode": "lease_with_heartbeat",
    "default_lease_hours": 12,
    "max_lease_hours": 24,
    "stale_action": "BLOCKED_REQUIRES_REVIEWER",
    "duplicate_work_item": "FORBIDDEN",
    "manager": "tools/control_plane_manager.py",
    "reconciliation_workflow": ".github/workflows/control-plane-reconcile.yml"
  },
  "projection_policy": {
    "mode": "deterministic_on_change",
    "source": "merged workstream state",
    "destination": ".airlab/control-plane/canonical-state.json#projection",
    "periodic_reconcile": "hourly",
    "event_reconcile": "main changes to workstreams/roadmaps/inference policy",
    "no_change_no_commit": true
  }
}
