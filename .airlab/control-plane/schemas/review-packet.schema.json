{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-packet.schema.json",
  "title": "AI Orchestrator worker review packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submitted_at",
    "lane_id",
    "claim_id",
    "work_item",
    "repository",
    "summary",
    "changes",
    "evidence",
    "known_risks",
    "reviewer_checks",
    "roadmap_impact"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "work_item": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "pull_request": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ref",
          "result"
        ],
        "properties": {
          "type": {
            "enum": [
              "ci",
              "test",
              "diagnostics",
              "runtime",
              "physical_device",
              "commit",
              "pull_request",
              "analysis",
              "other"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "INFO",
              "PENDING"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "roadmap_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material",
        "refs"
      ],
      "properties": {
        "material": {
          "type": "boolean"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
